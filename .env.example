# Copy this file to .env and fill in your values. Never commit .env.

# ---- Required for live runs ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Shown on screen during the whole demo (required by the assignment)
STUDENT_NAME=Your Name
ROLL_NUMBER=Your Roll Number

# ---- Model ids (verify on openrouter.ai before running) ----
MODEL_JEV=typesafe/jev-1.13
MODEL_LUNA=openai/gpt-6-luna-decisions
MODEL_CLEF=cloudflare/clef
MODEL_OPUS=anthropic/claude-opus-5.5

# ---- Experiment policy (identical for every model) ----
# Max turns per model per puzzle; reaching it counts as unsolved
MOVE_LIMIT=30
# HARD cap on paid API calls for the "budget" profile
MAX_CALLS=64
# Primary puzzles in the budget profile (each played by all 4 models)
BUDGET_PUZZLES=3
# Seconds per call
REQUEST_TIMEOUT=180
# Retries on timeouts / 5xx / 429 (each retry is a paid call)
RETRIES=0
# Recent moves sent to every model
HISTORY_LEN=6
# Same seed -> same scrambles
SEED=2026
CONCURRENCY=12

# ---- Claude Opus 5.5 (chat completions) ----
# low | medium | high | none
OPUS_REASONING_EFFORT=medium
OPUS_MAX_TOKENS=8000
# json_schema | json_object | none
OPUS_RESPONSE_FORMAT=json_schema
